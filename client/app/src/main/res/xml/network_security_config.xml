<?xml version="1.0" encoding="utf-8"?>
<!--
  HTTP sin cifrar permitido SOLO hacia el server por Tailscale (la VPN ya
  cifra el túnel por fuera); cleartext sigue bloqueado hacia cualquier otro
  destino.
  - "offcloud": nombre MagicDNS corto del PC servidor (lo que usa la app por
    defecto). Sigue funcionando aunque cambie la IP.
  - ts.net: nombre MagicDNS completo (offcloud.<tailnet>.ts.net).
  - La IP queda como respaldo. Android no admite rangos CIDR aquí, así que
    si el server cambia de IP hay que actualizarla (o usar el nombre).
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">offcloud</domain>
        <domain includeSubdomains="true">ts.net</domain>
        <domain includeSubdomains="false">100.119.30.85</domain>
    </domain-config>
</network-security-config>
