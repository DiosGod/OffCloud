<?xml version="1.0" encoding="utf-8"?>
<!--
  Icono OffCloud: nube en trazo morado claro, tachada con una barra morada
  ("Off" Cloud: fuera de la nube de otros). Todo dentro de la zona segura
  de los iconos adaptativos (círculo de radio 33 centrado en 54,54).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Nube: icono "cloud" de Material (24x24), escalado x1.9 y centrado. -->
    <group
        android:scaleX="1.9"
        android:scaleY="1.9"
        android:translateX="31.2"
        android:translateY="33.2">
        <path
            android:fillColor="#00000000"
            android:strokeColor="#FFC4B5FD"
            android:strokeWidth="1.7"
            android:strokeLineJoin="round"
            android:pathData="M19.35,10.04C18.67,6.59 15.64,4 12,4 9.11,4 6.6,5.64 5.35,8.04 2.34,8.36 0,10.91 0,14c0,3.31 2.69,6 6,6h13c2.76,0 5,-2.24 5,-5 0,-2.64 -2.05,-4.78 -4.65,-4.96z" />
    </group>

    <!-- Hueco oscuro alrededor de la barra, para que se separe de la nube. -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FF180F29"
        android:strokeWidth="9"
        android:strokeLineCap="round"
        android:pathData="M37,77L73,35" />

    <!-- Barra de "tachado". -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFA855F7"
        android:strokeWidth="4.2"
        android:strokeLineCap="round"
        android:pathData="M37,77L73,35" />
</vector>
